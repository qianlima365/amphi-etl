    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "kafkajs": "^2.2.4",
    "langchain": "^0.3.0",
    "lodash": "^4.17.21",
    "neo4j-driver": "^5.26.0",
