    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "agent:etl": "ts-node agents/etl-agent.ts",
    "agent:etl:cli": "ts-node agents/amphi-etl/cli/index.ts",
