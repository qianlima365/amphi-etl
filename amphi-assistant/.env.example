# ========================================
# AI Agent Framework 环境配置
# ========================================

# === 基础服务配置 ===
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# === LLM 配置 ===
# 硅基流动 (SiliconFlow) - 默认使用 OpenAI 协议对接
# 文档: https://docs.siliconflow.cn/
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V2.5
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_TEMPERATURE=0.7
SILICONFLOW_MAX_TOKENS=4096

# === 记忆层配置 ===
# Redis (短期记忆)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=agent_dev_pass
REDIS_DB=0

# PostgreSQL (长期记忆)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_pass
POSTGRES_DATABASE=agent_memory

# ChromaDB / Milvus (向量存储 - 知识记忆)
VECTOR_STORE_TYPE=chroma
CHROMA_URL=http://localhost:8000
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Neo4j / NebulaGraph (知识图谱/本体论)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

NEBULA_HOST=localhost
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula

# === 协作层配置 ===
# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=agent-framework
KAFKA_GROUP_ID=agent-cluster

# === 执行层配置 ===
# Dagster
DAGSTER_HOST=localhost
DAGSTER_PORT=3000

# Airbyte
AIRBYTE_HOST=localhost
AIRBYTE_PORT=8000
AIRBYTE_API_KEY=

# === 监控配置 ===
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# === 安全配置 ===
JWT_SECRET=your_jwt_secret_key_here
API_KEY_SALT=your_api_key_salt
