{
  "name": "@amphi/ai-service",
  "version": "1.0.0",
  "description": "AI Assistant Backend Service for Amphi ETL",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "db:init": "ts-node src/db/init.ts",
    "db:web": "sqlite_web data/ai-service.sqlite -p 8080 -H 0.0.0.0",
    "db:web:install": "pip install sqlite-web"
  },
  "keywords": ["amphi", "etl", "ai", "pipeline"],
  "license": "Apache-2.0",
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.4.0",
    "express-rate-limit": "^7.4.0",
    "swagger-ui-express": "^5.0.1",
    "swagger-jsdoc": "^6.2.8",
    "better-sqlite3": "^11.0.0",
    "uuid": "^10.0.0",
    "llamaindex": "^0.8.0",
    "@llamaindex/openai": "^0.2.0",
    "@llamaindex/anthropic": "^0.1.0",
    "@llamaindex/ollama": "^0.1.0",
    "@llamaindex/deepseek": "0.0.40",
    "js-yaml": "^4.1.0",
    "neo4j-driver": "^5.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/uuid": "^9.0.7",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.3.2",
    "ts-node": "^10.9.2"
  }
}
