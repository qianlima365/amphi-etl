# AI Service Configuration

# Server
PORT=3001
NODE_ENV=development

# CORS（前端页面来源，多个用逗号分隔；不填则允许所有 localhost 端口）
CORS_ORIGIN=http://localhost:8888,http://localhost:8889

# Database (用户 API Key 存储在 SQLite 中)
DB_PATH=./data/ai-service.sqlite

# Workspace
WORKSPACE_DIR=./workspaces

# Feature Flags
ENABLE_LLM_OPTIMIZATION=true

# ============================================
# 以下 API Key 配置为【可选】
# 用户通过前端界面配置自己的 API Key (存储在 SQLite)
# 这里的配置仅用于：
#   1. 开发测试
#   2. 平台管理员提供的默认 Key（用户未配置时使用）
# ============================================
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
