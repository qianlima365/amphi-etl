{
  "name": "@amphi/theme-neon-future",
  "version": "1.0.0",
  "description": "A professional dark enterprise theme for Amphi ETL - featuring deep indigo backgrounds, vibrant blue accents, and clean modern design",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "jupyterlab-theme",
    "dark-theme",
    "neon",
    "futuristic",
    "amphi"
  ],
  "homepage": "https://github.com/amphi-ai/amphi-etl",
  "bugs": {
    "url": "https://github.com/amphi-ai/amphi-etl/issues"
  },
  "license": "ELv2",
  "author": {
    "name": "Amphi ETL",
    "email": "contact@amphi.ai"
  },
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,eot,gif,html,jpg,json,png,svg,woff2,ttf}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/amphi-ai/amphi-etl.git"
  },
  "scripts": {
    "build": "jlpm run build:lib && jlpm run build:labextension:dev",
    "build:prod": "jlpm run build:lib && jlpm run build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:lib": "tsc --build --verbose",
    "clean": "jlpm run clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:labextension": "rimraf ../../amphi/theme-neon-future",
    "clean:all": "jlpm run clean:lib && jlpm run clean:labextension",
    "eslint": "eslint . --ext .ts,.tsx --fix",
    "eslint:check": "eslint . --ext .ts,.tsx",
    "install:extension": "jupyter labextension develop --overwrite .",
    "prepare": "jlpm run clean && jlpm run build:prod",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w",
    "watch:labextension": "jupyter labextension watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.9",
    "@jupyterlab/apputils": "^4.0.9"
  },
  "resolutions": {
    "@lumino/widgets": "^2.0.0",
    "@types/react": "^18.2.7"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^4.8.1",
    "@typescript-eslint/parser": "^4.8.1",
    "eslint": "^7.14.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-react": "^7.18.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.1.1",
    "rimraf": "^3.0.2",
    "typescript": "~5.0.4",
    "yarn-deduplicate": "^6.0.2"
  },
  "sideEffects": [
    "style/*.css"
  ],
  "jupyterlab": {
    "extension": true,
    "themePath": "style/index.css",
    "outputDir": "../../amphi/theme-neon-future"
  }
}
